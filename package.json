{
  "name": "vero360app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "dev:turbo": "next dev",
    "create-admin": "node scripts/create-panel-admin-curl.cjs",
    "create-admin:firebase-admin": "node --dns-result-order=ipv4first scripts/create-panel-admin.cjs",
    "build": "next build --webpack && node scripts/copy-standalone-assets.cjs",
    "start": "next start",
    "start:prod": "next start",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js --update-env",
    "pm2:stop": "pm2 stop vero360web",
    "pm2:delete": "pm2 delete vero360web",
    "pm2:logs": "pm2 logs vero360web",
    "deploy": "npm run build && pm2 startOrReload ecosystem.config.js --update-env",
    "lint": "eslint"
  },
  "dependencies": {
    "firebase": "^11.0.2",
    "firebase-admin": "^14.2.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "jose": "4.15.9"
  }
}
